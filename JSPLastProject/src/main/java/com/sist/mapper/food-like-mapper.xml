<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.mapper.food-like-mapper">
	<insert id="foodLikeInsert" parameterType="FoodLikeVO">
		INSERT INTO food_like(id,fno,member_id)
		VALUES(
			food_like_seq.nextval,
			#{fno},
			#{member_id}
		)
	</insert>
	<select id="foodLikeChecked" parameterType="FoodLikeVO" resultType="int">
		SELECT COUNT(*)
		FROM food_like
		WHERE member_id=#{member_id} AND fno=#{fno}
	</select>
	<insert id="foodLikeDelete" parameterType="FoodLikeVO">
		DELETE FROM food_like
		WHERE fno=#{fno} AND member_id=#{member_id}
	</insert>
	
	
</mapper>