<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.model.food-mapper">
	<!--
		html 기본태그
		css 약간의 수정 , 선택자
		javascript : 기본문법,변수,연산자,제어문,배열
		내장객체 
		window documnet history location
		태그읽기(DOM)
		querySelector/getElementById()
		jquery / ajax
		자바 => 기본문법 : 어노테이션 / xml파싱
		jsp : 지시자 (page, taglib)
				내장객체 (request,response, session, application)
				JSTL/EL
				<c:forEach> <c:if> <c:choose>
				${}
		MVC 
			요청 = controller = model = dao = model = controller = jsp
		오라클
			curd
			내장함수,연산자,join,subquery
		mybatis
			sql문장 / 처리 소스가 나눠서 작업
					= DAO
			= mapper.xml
				| parameterType에 2개 이상 지정할때 : vo, map 사용
				| 함수 사용시에는 반드시 별칭, 별칭줘야할 데이터가 많은 경우에는 =>	resultMap으로 설정
	 -->
	<select id="foodListData" resultType="FoodVO" parameterType="int">
		SELECT no,name,poster,address
		FROM food
		ORDER BY no ASC
		OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
	</select>
	<select id="foodTotalPage" resultType="int">
		SELECT CEIL(COUNT(*)/12.0) FROM food
	</select>
	<select id="foodDetailData" resultType="FoodVO" parameterType="int">
		SELECT *
		FROM food
		WHERE no=#{no}
	</select>
</mapper>