<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
	String sql =
	SELECT empno,ename,job,hiredate,sal,dname,loc
	FROM emp,dept
	WHERE emp.deptno=dept.deptno
	ORDER BY empno ASC
	
	ps = conn.prepareStatement(sql);
	ResultSet = ps.executeQuery();
	while(rs.next){
		EmpVO vo = new EmpVO():
		vo.setEmpno(rs.getInt(1))
		vo.setEname
		vo.setJob
		vo.setHiredate
		vo.setSal
		***vo.getDvo().setDname()		=> resultMap으로 별도설정 필요
		vo.getDvo().setLoc()
	}
	
	JOIN, subquery => 2개이상의 테이블을 연결할때
 -->

<mapper namespace="com.sist.dao.emp-mapper">
	<resultMap type="com.sist.dao.EmpVO" id="empMap">
		<result property="dvo.dname" column="dname"/>		<!-- vo.getDvo().setDname()으로 변경되어서 값을 채워줌 -->
		<result property="dvo.loc" column="loc"/>			<!-- vo.getDvo().setLoc() -->
	</resultMap>
	<select id="empListData" resultMap="empMap">
		SELECT empno,ename,job,TO_CHAR(hiredate,'YYYY-MM-DD') as dbday,sal,dname,loc
		FROM emp,dept
		WHERE emp.deptno=dept.deptno
		ORDER BY empno ASC
	</select>
</mapper>